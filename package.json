{
  "name": "browser-helper-lite",
  "description": "BYOK, vendor-neutral AI side panel assistant for Chrome",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanzhrepo/browser-helper-lite.git"
  },
  "bugs": {
    "url": "https://github.com/ethanzhrepo/browser-helper-lite/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:no-cdp": "ENABLE_CDP_DRIVER=false wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E_GRANT_ALL_HOSTS=true wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/deepseek": "3.0.70",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/openai-compatible": "3.0.75",
    "@mozilla/readability": "^0.6.0",
    "ai": "7.0.148",
    "dexie": "^4.4.6",
    "i18next": "^26.5.5",
    "katex": "0.19.0",
    "lucide-react": "^1.61.0",
    "mermaid": "11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "turndown": "^7.2.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.19.0"
    }
  }
}
